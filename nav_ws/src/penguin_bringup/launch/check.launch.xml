<launch>
  <arg name="world_sdf_file" default="$(find-pkg-share penguin_bringup)/worlds/park.sdf" />

  <arg name="robot_sdf_file" default="$(find-pkg-share nav2_minimal_tb3_sim)/urdf/turtlebot3_waffle.urdf" />
  <include file="$(find-pkg-share nav2_minimal_tb3_sim)/launch/spawn_tb3.launch.py">
    <arg name="x_pose" value="0" />
    <arg name="y_pose" value="0" />
    <arg name="z_pose" value="0.1" />
  </include>
  <executable name="gzserver" cmd="gz sim -r $(var world_sdf_file)" output="screen" />
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="use_sim_time" value="true" />
    <param name="robot_description" value="$(file-content $(var robot_sdf_file))" />
  </node>

  <include file="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py">
    <arg name="use_localization" value="False" />
    <arg name="use_sim_time" value="True" />
    <!-- <arg name="slam" value="True" /> -->
    <arg name="params_file" value="$(find-pkg-share penguin_bringup)/config/nav2_params.yaml" />
  </include>
  <!-- <include file="$(find-pkg-share nav2_bringup)/launch/rviz_launch.py">
  </include> -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(find-pkg-share penguin_bringup)/config/nav.rviz" output="screen" />
  <node pkg="tf2_ros" exec="static_transform_publisher" args="0 0 0 0 0 0 map odom" />

</launch>
